diff --git a/main/application.cc b/main/application.cc
index e1f0719..64a72a2 100644
--- a/main/application.cc
+++ b/main/application.cc
@@ -17,11 +17,53 @@
 #include <arpa/inet.h>
 #include <cJSON.h>
 #include <algorithm>
+#include <atomic>
 #include <cstring>
 #include <limits>
 
 #define TAG "Application"
 
+namespace {
+
+// Sent in place of a wake word when the assistant starts talking on its own.
+constexpr const char* kProactiveWakeWord = "__proactive__";
+
+#if CONFIG_PROACTIVE_CHECK_SECONDS > 0
+std::atomic<bool> proactive_check_running{false};
+
+// Runs off the main task because HTTP can block. A failure stays silent: the
+// server being off must not make an idle device play an error sound.
+void ProactiveCheckTask(void*) {
+    bool speak = false;
+    {
+        auto http = Board::GetInstance().GetNetwork()->CreateHttp(0);
+        if (http->Open("GET", CONFIG_PROACTIVE_URL)) {
+            auto status = http->GetStatusCode();
+            speak = status && *status == 200 && http->ReadAll().find("true") != std::string::npos;
+            http->Close();
+        }
+    }
+    auto& app = Application::GetInstance();
+    if (speak && app.GetDeviceState() == kDeviceStateIdle) {
+        ESP_LOGI(TAG, "Starting a proactive conversation");
+        app.WakeWordInvoke(kProactiveWakeWord);
+    }
+    proactive_check_running = false;
+    vTaskDelete(nullptr);
+}
+
+void StartProactiveCheck() {
+    if (proactive_check_running.exchange(true)) {
+        return;
+    }
+    if (xTaskCreate(ProactiveCheckTask, "proactive", 6144, nullptr, 2, nullptr) != pdPASS) {
+        proactive_check_running = false;
+    }
+}
+#endif
+
+}  // namespace
+
 Application::Application() : notify_player_(audio_service_) {
     event_group_ = xEventGroupCreate();
 
